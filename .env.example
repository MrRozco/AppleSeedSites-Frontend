# Strapi base URL (public: used for read-only API calls and image URLs).
# NEXT_PUBLIC_STRAPI_URL is accepted as an alias.
NEXT_PUBLIC_STRAPI_API_URL=https://incredible-friendship-84da35b266.strapiapp.com

# Server-only. Strapi API token used by /api/lead to save form submissions.
# Create it in Strapi admin → Settings → API Tokens: type "Custom", permission Lead → create only.
# Never prefix it with NEXT_PUBLIC_. STRAPI_API_TOKEN is accepted as an alias.
STRAPI_LEADS_TOKEN=

# Server-only. Shared secret for the Strapi webhook that calls /api/revalidate on publish.
# Send it from Strapi as the header "Authorization: Bearer <secret>".
REVALIDATE_SECRET=
